{
  "name": "bodhinox-chat",
  "version": "0.8.0",
  "private": true,
  "description": "Bodhinox Chat: WhatsApp CRM and automation with JWT, Prisma and Railway PostgreSQL",
  "license": "MIT",
  "author": "Arnas Donauskas",
  "homepage": "https://github.com/UDAY368/bodhinox_chat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UDAY368/bodhinox_chat.git"
  },
  "bugs": {
    "url": "https://github.com/UDAY368/bodhinox_chat/issues"
  },
  "keywords": [
    "crm",
    "whatsapp",
    "whatsapp-business-api",
    "nextjs",
    "automation",
    "broadcast",
    "self-hosted",
    "template"
  ],
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "worker": "tsx src/lib/jobs/worker.ts",
    "db:migrate": "prisma migrate deploy",
    "db:roles": "tsx scripts/db-bootstrap-roles.ts",
    "db:preflight": "tsx scripts/db-preflight.ts",
    "db:seed": "tsx scripts/db-seed-defaults.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@base-ui/react": "^1.9.0",
    "@dagrejs/dagre": "^3.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@xyflow/react": "^12.12.0",
    "argon2": "0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.2",
    "date-fns": "^4.4.0",
    "dotenv": "18.0.9",
    "jose": "6.2.12",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-intl": "^4.14.8",
    "nodemailer": "10.1.4",
    "opus-recorder": "^8.0.5",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1",
    "postcss": "^8.5.10",
    "ip-address": "^10.7.1",
    "fast-uri": "^3.1.9",
    "hono": "^4.13.5",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.17",
    "@babel/core": "^7.29.6",
    "sharp": "^0.35.5",
    "brace-expansion@^1.0.0": "^1.1.21",
    "brace-expansion@^5.0.0": "^5.0.12",
    "proxy-addr": "^2.0.8",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "undici": "^7.29.1",
    "source-map-js": "^1.2.2",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6"
  }
}
