  avatar_url String?
  created_at DateTime? @db.Timestamptz(6) @default(now())
  updated_at DateTime? @db.Timestamptz(6) @default(now())
  account_id String @db.Uuid @default(dbgenerated("NULLIF(current_setting('app.account_id', true),'')::uuid "))
  phone_normalized String  @default(dbgenerated())
  wa_user_id String?
  wa_parent_user_id String?
  wa_username String?
  inbound_created_meta_id String?
  @@unique([account_id, id])
}

