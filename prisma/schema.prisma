  description String?
  status String  @default("draft")
  trigger_type String
  trigger_config Json @db.JsonB @default(dbgenerated("'{}'::jsonb"))
  entry_node_id String?
  fallback_policy Json @db.JsonB @default(dbgenerated("'{\"on_unknown_reply\":\"reprompt\",\"max_reprompts\":2,\"on_timeout_hours\":24,\"on_exhaust\":\"handoff\"}'::jsonb"))
  execution_count Int  @default(0)
  last_executed_at DateTime? @db.Timestamptz(6)
