model conversations {
  id String @db.Uuid @id @default(dbgenerated("gen_random_uuid()"))
  user_id String @db.Uuid
  contact_id String @db.Uuid
  status String  @default("open")
  assigned_agent_id String? @db.Uuid
  last_message_text String?
  last_message_at DateTime? @db.Timestamptz(6)
  unread_count Int?  @default(0)
  created_at DateTime? @db.Timestamptz(6) @default(now())
  updated_at DateTime? @db.Timestamptz(6) @default(now())
  account_id String @db.Uuid @default(dbgenerated("NULLIF(current_setting('app.account_id', true),'')::uuid "))
  ai_autoreply_disabled Boolean  @default(false)
  ai_reply_count Int  @default(0)
  ai_handoff_summary String?
  ai_handoff_at DateTime? @db.Timestamptz(6)
  bot_paused Boolean  @default(false)
  inbound_created_meta_id String?
  whatsapp_config_id String? @db.Uuid
  lifecycle_state String  @default("requesting")
  first_response_due_at DateTime? @db.Timestamptz(6)
  first_responded_at DateTime? @db.Timestamptz(6)
  resolved_at DateTime? @db.Timestamptz(6)
  reopened_count Int  @default(0)
  /// Phase 11: 'whatsapp' | 'instagram'. Server-managed; an Instagram row names instagram_account_id and never a number.
  channel String @default("whatsapp")
  instagram_account_id String? @db.Uuid
  // 20261109101100/101200: partial unique indexes idx_conversations_wa_contact_number (WhatsApp, NULLS NOT DISTINCT)
  // and idx_conversations_ig_contact_account (Instagram) are built CONCURRENTLY by the SQL; conversations_channel_sender_check is owned by the SQL.
  @@unique([account_id, id])
}

