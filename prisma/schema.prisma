  archived_at DateTime? @db.Timestamptz(6)
  /// Phase 11: 'whatsapp' | 'instagram' | 'any'.
  channel_scope String @default("whatsapp")
  /// Phase 12: the live flow_versions row; null until first published. Status adds 'paused'.
  published_version_id String? @db.Uuid
  @@unique([account_id, id])
}

