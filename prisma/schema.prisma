model flow_runs {
  id String @db.Uuid @id @default(dbgenerated("gen_random_uuid()"))
  flow_id String @db.Uuid
  user_id String @db.Uuid
  contact_id String? @db.Uuid
  conversation_id String? @db.Uuid
  status String  @default("active")
  current_node_key String?
  transition_seq Int @default(0)
  last_prompt_message_id String? @db.Uuid
  vars Json @db.JsonB @default(dbgenerated("'{}'::jsonb"))
  reprompt_count Int  @default(0)
  started_at DateTime @db.Timestamptz(6) @default(now())
  last_advanced_at DateTime @db.Timestamptz(6) @default(now())
  ended_at DateTime? @db.Timestamptz(6)
  end_reason String?
  delay_until DateTime? @db.Timestamptz(6)
  wait_until DateTime? @db.Timestamptz(6)
  account_id String @db.Uuid @default(dbgenerated("NULLIF(current_setting('app.account_id', true),'')::uuid "))
  /// Phase 12: the version the run is pinned to; null for draft test-number and legacy runs.
  flow_version_id String? @db.Uuid
  // 20261110100300: the partial index flow_runs_version_active_idx (WHERE status='active') is owned by the SQL.
  @@unique([account_id, id])
}

/// Phase 12: immutable published snapshot of a flow (20261110100000_flow_versions). No UPDATE or DELETE
/// grant to any role; read and written only through withTenant raw SQL (never the generic data client).
model flow_versions {
  id String @db.Uuid @id @default(dbgenerated("gen_random_uuid()"))
  account_id String @db.Uuid @default(dbgenerated("NULLIF(current_setting('app.account_id', true),'')::uuid "))
  flow_id String @db.Uuid
  version Int
  trigger_type String
  trigger_config Json @db.JsonB
  entry_node_id String?
  fallback_policy Json @db.JsonB
  channel_scope String
  /// [{node_key,node_type,config,position_x,position_y}]
  nodes Json @db.JsonB
  published_by String? @db.Uuid
  published_at DateTime @db.Timestamptz(6) @default(now())
  @@unique([account_id, id])
  @@unique([account_id, flow_id, id])
  @@unique([account_id, flow_id, version])
}

