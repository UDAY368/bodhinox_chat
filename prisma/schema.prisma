// Scalar ORM mapping; reviewed SQL owns composite FKs, RLS, triggers and generated columns.

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}


model profiles {
  id String @db.Uuid @id @default(dbgenerated("gen_random_uuid()"))
  user_id String @db.Uuid
  full_name String
  email String
  avatar_url String?
  role String?  @default("user")
  created_at DateTime? @db.Timestamptz(6) @default(now())
  updated_at DateTime? @db.Timestamptz(6) @default(now())
  beta_features String[]  @default(dbgenerated("ARRAY[]::TEXT[]"))
  account_id String @db.Uuid @default(dbgenerated("NULLIF(current_setting('app.account_id', true),'')::uuid "))
  account_role String
  @@unique([user_id])
  @@unique([account_id, id])
}

model contacts {
  id String @db.Uuid @id @default(dbgenerated("gen_random_uuid()"))
  user_id String @db.Uuid
  phone String
  name String?
  email String?
  company String?
  avatar_url String?
  created_at DateTime? @db.Timestamptz(6) @default(now())
  updated_at DateTime? @db.Timestamptz(6) @default(now())
  account_id String @db.Uuid @default(dbgenerated("NULLIF(current_setting('app.account_id', true),'')::uuid "))
  phone_normalized String  @default(dbgenerated())
  wa_user_id String?
  wa_parent_user_id String?
  wa_username String?
  inbound_created_meta_id String?
  opted_out_at DateTime? @db.Timestamptz(6)
  opt_out_source String?
  blocked_at DateTime? @db.Timestamptz(6)
  @@unique([account_id, id])
}

