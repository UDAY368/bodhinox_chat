# Local development: public proxy port is 26854; 5432 is the private container port.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://bodhinox_app:REPLACE_WITH_RANDOM_ROLE_PASSWORD@iriguchi.proxy.rlwy.net:26854/railway?sslmode=verify-ca&uselibpqcompat=true&sslrootcert=REPLACE_WITH_ABSOLUTE_CA_PATH
AUTH_DATABASE_URL=postgresql://bodhinox_auth:REPLACE_WITH_RANDOM_ROLE_PASSWORD@iriguchi.proxy.rlwy.net:26854/railway?sslmode=verify-ca&uselibpqcompat=true&sslrootcert=REPLACE_WITH_ABSOLUTE_CA_PATH
WORKER_DATABASE_URL=postgresql://bodhinox_worker:REPLACE_WITH_RANDOM_ROLE_PASSWORD@iriguchi.proxy.rlwy.net:26854/railway?sslmode=verify-ca&uselibpqcompat=true&sslrootcert=REPLACE_WITH_ABSOLUTE_CA_PATH
# Migration/bootstrap commands only; omit this credential from deployed web/worker services.
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE_WITH_OWNER_PASSWORD@iriguchi.proxy.rlwy.net:26854/railway?sslmode=verify-ca&uselibpqcompat=true&sslrootcert=REPLACE_WITH_ABSOLUTE_CA_PATH
DB_POOL_SIZE=5
AUTH_JWT_PRIVATE_KEY="REPLACE_WITH_PKCS8_RSA_PRIVATE_KEY_WITH_ESCAPED_NEWLINES"
AUTH_JWT_PUBLIC_KEY="REPLACE_WITH_SPKI_RSA_PUBLIC_KEY_WITH_ESCAPED_NEWLINES"
AUTH_JWT_KID=initial-2026-10
AUTH_JWT_ISSUER=http://localhost:3000
AUTH_JWT_AUDIENCE=bodhinox-chat-api
AUTH_MFA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
AUTOMATION_CRON_SECRET=REPLACE_WITH_RANDOM_SECRET
AUTOMATION_TIMEZONE=Asia/Kolkata
# Configure later: email operations fail closed until these are set.
SMTP_URL=
AUTH_EMAIL_FROM=
# Private S3-compatible bucket; use Railway reference variables in production.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Configure the official Meta WhatsApp integration in Settings.
# META_APP_SECRET may hold several comma-separated secrets (webhook signatures accept any).
META_APP_SECRET=
META_APP_ID=
# WhatsApp Embedded Signup ("Connect with Facebook"). Both public ids must be set or the
# button is hidden and /api/whatsapp/embedded-signup answers 503. NEXT_PUBLIC_META_APP_ID
# should be the same app as META_APP_ID. The code exchange uses META_APP_SECRET_PRIMARY when
# set, otherwise the FIRST value of META_APP_SECRET. NEXT_PUBLIC_ values are inlined at build.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_SECRET_PRIMARY=
# Click-to-WhatsApp ads (Phase 10). Leave META_ADS_ENABLED unset until the Meta app has
# Marketing API / leads_retrieval / whatsapp_business_manage_events approval.
# META_ADS_LOGIN_CONFIG_ID is a Facebook Login for Business configuration of the META_APP_ID app;
# the browser receives it from /api/meta-ads/status, so turning ads on needs no rebuild.
META_ADS_ENABLED=
META_ADS_LOGIN_CONFIG_ID=
META_PAGE_WEBHOOK_VERIFY_TOKEN=
# Zoom meetings for online appointments (Phase 9). Off unless ZOOM_ENABLED=true AND all three
# values of the Zoom General (OAuth) app are set; each workspace admin then connects its own
# Zoom account in Settings -> Meetings & shipping. Leave ZOOM_ENABLED unset until Zoom approves
# the app. Webhook URL: <APP_URL>/api/integrations/zoom/webhook. See docs/deployment/railway.md.
ZOOM_ENABLED=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
# Shiprocket courier shipping (Phase 9) needs no deployment secret: each workspace enters its
# own Shiprocket API user. SHIPROCKET_DISABLED=true is an emergency kill switch that stops
# every Shiprocket call on this deployment.
SHIPROCKET_DISABLED=
# Instagram DMs and comment replies (Phase 11; Instagram API with Instagram Login). Off unless
# INSTAGRAM_ENABLED=true AND the Instagram app id, app secret and webhook verify token are set;
# while off nothing calls Instagram. Leave it unset until App Review grants
# instagram_business_basic + instagram_business_manage_messages (+ _manage_comments for comment
# replies) and the live check passes. INSTAGRAM_APP_SECRET may be a comma-separated list.
# Webhook URL: <APP_URL>/api/meta/instagram-webhook. Redirect URI defaults to
# <APP_URL>/api/instagram/callback. INSTAGRAM_HUMAN_AGENT_ENABLED=true only after Meta approves
# the Human Agent feature. See docs/deployment/railway.md.
INSTAGRAM_ENABLED=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_HUMAN_AGENT_ENABLED=
# Server-side Google Gemini key for the AI agent. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Emergency kill switch for every outbound AI call (chat and embeddings, all features).
# Unset or any other value = AI allowed (workspaces with their own keys keep auto-reply,
# drafts and flow AI). false, 0 or off (any case) = no provider call of any kind.
# The AI assistant features are additionally off per workspace until an admin turns them on.
AI_ENABLED=
# Platform administration console (Phase 14). Unset = /platform and /api/platform/* answer 404
# for everyone. Login of the bodhinox_platform role (created by migration, NOLOGIN until
# db-bootstrap-roles sets a password); it may only call crm_platform_* functions. Only users whose
# email is in PLATFORM_ADMIN_EMAILS (comma-separated) and who passed MFA within
# PLATFORM_ADMIN_MFA_MAX_AGE ("90m" or "12h"; default 12h, maximum 24h) can use the console.
PLATFORM_DATABASE_URL=
PLATFORM_ADMIN_EMAILS=
PLATFORM_ADMIN_MFA_MAX_AGE=
# Plan id given to newly created workspaces (for example basic). Unset = the lowest plan in the
# catalogue (free), never the unrestricted enterprise. Existing workspaces are never changed.
NEW_WORKSPACE_PLAN=
# Version string of the published terms of service. Unset = no terms checkbox or banner.
TERMS_VERSION=
# Secret salt for hashing request IPs in the platform audit trail.
AUDIT_IP_SALT=
# Operations (Phase 15). Token for the deep health check: GET /api/health?deep=1 with
# "Authorization: Bearer <HEALTH_TOKEN>" (never in the URL). At least 32 characters; unset or
# shorter = deep mode off and every caller gets the plain liveness response. Needs
# PLATFORM_DATABASE_URL to read the queue/worker signals. See docs/runbooks/alerts.md.
HEALTH_TOKEN=
# Deep-health thresholds (defaults shown in brackets): newest worker heartbeat older than
# HEALTH_WORKER_DOWN_S [90] = down; oldest due job older than HEALTH_OLDEST_DUE_DEGRADED_S [300]
# = degraded; more unknown outbound intents than HEALTH_UNKNOWN_INTENTS_DEGRADED [0] = degraded.
HEALTH_WORKER_DOWN_S=
HEALTH_OLDEST_DUE_DEGRADED_S=
HEALTH_UNKNOWN_INTENTS_DEGRADED=
# Optional worker alert hook: an https URL that receives a JSON POST (with a "text" summary) when
# the health status changes, repeated every 15 minutes while down. Unset = off. Worker service only.
OPS_ALERT_WEBHOOK_URL=
# Worker shutdown: after SIGTERM the in-flight job gets up to this many ms [25000] to finish, then
# the worker exits and the job's lease returns it to the queue. Keep Railway's draining time >= this.
WORKER_DRAIN_MS=
# Optional: worker job slots (1-16, default 3): one for short jobs, the rest for campaigns and other long jobs.
WORKER_CONCURRENCY=
